# Copy to apps/web/.env.local (preferred), or put the same vars in the monorepo root `.env`
# (next.config.ts merges root `.env` / `.env.local` when a key is not already set — restart dev after changes).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional legacy name (same value as old “anon” / JWT key if you are not using publishable keys yet):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Dashboard → Authentication → URL configuration (hosted project, not local config.toml):
#   Site URL: your production app (e.g. https://udeets-ui-web.vercel.app)
#   Redirect URLs — add every environment you use (exact paths, no query string):
#     https://udeets-ui-web.vercel.app/auth/callback
#     http://localhost:3000/auth/callback
#     http://127.0.0.1:3000/auth/callback
# If localhost sign-in opens the Vercel URL, Site URL or Redirect URLs are missing localhost.
