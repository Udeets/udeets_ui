# Copy to apps/web/.env.local (preferred), or put the same vars in the monorepo root `.env`
# (next.config.ts merges root `.env` / `.env.local` when a key is not already set — restart dev after changes).

# Cognito Hosted UI (authentication)
NEXT_PUBLIC_COGNITO_DOMAIN=https://your-domain.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=your_app_client_id
# Optional override. By default we use {origin}/auth/callback
# NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
# OAuth scopes (must match Cognito app client "Allowed OAuth Scopes" exactly)
# NEXT_PUBLIC_COGNITO_OAUTH_SCOPES=openid email phone
# Federated IdP names (User pool → Sign-in experience → Federated identity providers → Provider name)
# NEXT_PUBLIC_COGNITO_GOOGLE_IDP=Google
# NEXT_PUBLIC_COGNITO_APPLE_IDP=SignInWithApple

# Public base URL for S3 media (CloudFront or bucket URL). Must match API `S3_PUBLIC_BASE_URL`.
# Used by next/image allowlist — set the same host the API returns on public media URLs.
# NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=https://your-cdn.example.com

# FastAPI backend (browser uses same-origin /api/v1 proxy; SSR may call base URL directly).
# REST and WebSocket must use the same host:port as apps/api PORT (default 8000).
NEXT_PUBLIC_FASTAPI_BASE_URL=http://localhost:8000

# Chat realtime (WebSocket connects directly to FastAPI, not the Next proxy)
NEXT_PUBLIC_FASTAPI_WS_URL=ws://localhost:8000/api/v1/chat/ws
NEXT_PUBLIC_CHAT_REALTIME_ENABLED=false
NEXT_PUBLIC_CHAT_POLLING_FALLBACK_ENABLED=true

# Cognito App Client callback/logout URLs should include every environment:
#   https://udeets-ui-web.vercel.app/auth/callback
#   http://localhost:3000/auth/callback
#   http://127.0.0.1:3000/auth/callback
# and logout URL:
#   https://udeets-ui-web.vercel.app/auth
#   http://localhost:3000/auth
